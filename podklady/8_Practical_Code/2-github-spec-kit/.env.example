# Database
DATABASE_URL=postgres://imagineer:imagineer@localhost:5432/imagineer

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible — MinIO locally, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=imagineer
S3_SECRET_KEY=imagineer
S3_BUCKET_UPLOADS=imagineer-uploads
S3_BUCKET_MODELS=imagineer-models
S3_BUCKET_THUMBNAILS=imagineer-thumbnails
S3_PUBLIC_BASE_URL=http://localhost:9000

# Generation provider
GENERATION_PROVIDER=meshy
MESHY_BASE_URL=http://localhost:8787
MESHY_API_KEY=mock-key
TRIPO_BASE_URL=https://api.tripo3d.ai
TRIPO_API_KEY=

# Auth (Auth.js)
AUTH_SECRET=change-me-32-bytes-hex
AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_test_xxx
EMAIL_FROM=hello@imagineer.example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:3000/orders/{ORDER_ID}?ok=1
STRIPE_CANCEL_URL=http://localhost:3000/order/new?cancelled=1

# Shipping (Shippo)
SHIPPO_API_KEY=shippo_test_xxx
SHIPPO_WEBHOOK_SECRET=change-me

# Address validation (SmartyStreets)
SMARTYSTREETS_AUTH_ID=test
SMARTYSTREETS_AUTH_TOKEN=test

# Slicer
PRUSASLICER_BIN=/usr/bin/prusa-slicer

# Observability
SENTRY_DSN=
LOG_LEVEL=info
NODE_ENV=development
