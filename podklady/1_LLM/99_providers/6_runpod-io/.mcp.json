{
    "mcpServers": {
        "runpod-api": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@runpod/mcp-server@latest"
            ],
            "env": {
                "RUNPOD_API_KEY": "${RUNPOD_KEY}"
            }
        },
        "runpod-docs": {
            "type": "http",
            "url": "https://docs.runpod.io/mcp"
        },
        "huggingface": {
            "type": "http",
            "url": "https://huggingface.co/mcp",
            "headers": {
                "Authorization": "Bearer ${HF_TOKEN}"
            }
        }
    }
}