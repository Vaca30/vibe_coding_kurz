{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["We are in 7_hooks"],
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Edit",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Read",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "ToolSearch",
      "Write",
      "mcp__playwright-test"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/)",
      "Bash(rm -r -f /)",
      "Bash(rm -r -f ~)",
      "Bash(rm -r -f /*)",
      "Bash(rm -r -f ~/)",
      "Bash(sudo rm -rf /)",
      "Bash(sudo rm -rf ~)",
      "Bash(sudo rm -rf /*)",
      "Bash(sudo rm -rf ~/)",
      "Bash(sudo rm -r -f /)",
      "Bash(sudo rm -r -f ~)",
      "Bash(sudo rm -r -f /*)",
      "Bash(sudo rm -r -f ~/)",

      "Read(./.venv/**)",
      "Glob(./.venv/**)",
      "Grep(./.venv/**)",
      "Edit(./.venv/**)",
      "Write(./.venv/**)",
      "Read(./**/venv/**)",
      "Glob(./**/venv/**)",
      "Grep(./**/venv/**)",
      "Read(./**/.venv/**)",
      "Glob(./**/.venv/**)",
      "Grep(./**/.venv/**)",

      "Read(./node_modules/**)",
      "Glob(./node_modules/**)",
      "Grep(./node_modules/**)",
      "Edit(./node_modules/**)",
      "Write(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Glob(./**/node_modules/**)",
      "Grep(./**/node_modules/**)",

      "Read(~/.ssh/**)",
      "Glob(~/.ssh/**)",
      "Grep(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Glob(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Write(~/.gnupg/**)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Glob(./.env*)",
      "Read(./secrets/**)",
      "Glob(./secrets/**)",
      "Read(./.secrets/**)",
      "Glob(./.secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./config/secrets.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",

      "Read(./.git/**)",
      "Glob(./.git/**)",
      "Grep(./.git/**)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Read(./.git/worktrees/**)",

      "Read(./build/**)",
      "Glob(./build/**)",
      "Grep(./build/**)",
      "Read(./dist/**)",
      "Glob(./dist/**)",
      "Grep(./dist/**)",
      "Read(./.next/**)",
      "Glob(./.next/**)",
      "Grep(./.next/**)",
      "Read(./.nuxt/**)",
      "Glob(./.nuxt/**)",
      "Read(./out/**)",
      "Glob(./out/**)",
      "Read(./__pycache__/**)",
      "Glob(./__pycache__/**)",
      "Read(./**/__pycache__/**)",
      "Glob(./**/__pycache__/**)",
      "Read(./.cache/**)",
      "Glob(./.cache/**)",
      "Read(./.parcel-cache/**)",
      "Glob(./.parcel-cache/**)",
      "Read(./.turbo/**)",
      "Glob(./.turbo/**)",
      "Read(./target/**)",
      "Glob(./target/**)",
      "Read(./*.egg-info/**)",
      "Glob(./*.egg-info/**)",

      "Read(./.yarn/cache/**)",
      "Glob(./.yarn/cache/**)",
      "Read(./.pnpm-store/**)",
      "Glob(./.pnpm-store/**)",
      "Read(./.npm/**)",
      "Glob(./.npm/**)",
      "Read(~/.npm/**)",
      "Read(~/.yarn/**)",
      "Read(~/.pnpm-store/**)",
      "Read(~/.cache/pip/**)",

      "Read(./.idea/**)",
      "Glob(./.idea/**)",
      "Edit(./.idea/**)",
      "Write(./.idea/**)",
      "Read(./.vscode/**)",
      "Glob(./.vscode/**)",
      "Read(./*.swp)",
      "Read(./**/*.swp)",
      "Read(./*.swo)",
      "Read(./**/*.swo)",

      "Read(./.DS_Store)",
      "Read(./**/.DS_Store)",
      "Read(./Thumbs.db)",
      "Read(./**/Thumbs.db)",

      "Read(./docker-data/**)",
      "Glob(./docker-data/**)",
      "Read(./.docker/**)",
      "Glob(./.docker/**)",

      "Read(./**/*.log)",
      "Glob(./**/*.log)",
      "Read(./logs/**)",
      "Glob(./logs/**)",

      "Read(./.terraform/**)",
      "Glob(./.terraform/**)",
      "Read(./terraform.tfstate)",
      "Read(./terraform.tfstate.backup)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",

      "Read(./coverage/**)",
      "Glob(./coverage/**)",
      "Read(./.nyc_output/**)",
      "Glob(./.nyc_output/**)",
      "Read(./htmlcov/**)",
      "Glob(./htmlcov/**)",

      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.gcloud/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(./**/serviceAccountKey.json)",
      "Read(./**/*credentials*.json)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.gitconfig)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "STOP — before finishing, perform this self-check:\n1. Did you create or modify any code files (.py, .js, .ts, .go, etc.) in this session?\n2. If YES: did you also run the relevant test suite (pytest, npm test, etc.)?\n3. If tests exist but were NOT run — run them now.\n4. If no tests exist for the changed code — write tests first, then run them.\n5. If you only made non-code changes (docs, config, comments) — you may finish.\nDo NOT skip this check."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/pretool_git_guardian.py",
            "timeout": 5,
            "statusMessage": "Checking for dangerous git operations..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "agent",
            "prompt": "You are a security reviewer. Inspect this tool call:\n$ARGUMENTS\n\nCheck if the file content being written contains:\n- Hardcoded secrets, API keys, passwords, or tokens\n- SQL injection vulnerabilities (string concatenation in queries)\n- Command injection (unsanitized input passed to shell commands)\n- Insecure use of eval(), exec(), or similar dynamic execution\n\nIf you find a security issue, respond with JSON:\n{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"permissionDecisionReason\": \"<describe the issue>\"}}\n\nIf the code looks safe, respond with JSON:\n{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"allow\"}}",
            "timeout": 30,
            "statusMessage": "Security review in progress..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/posttool_format_python.py",
            "timeout": 15,
            "statusMessage": "Auto-formatting Python files..."
          },
          {
            "type": "http",
            "url": "http://localhost:9111/audit",
            "timeout": 5,
            "statusMessage": "Sending audit log..."
          }
        ]
      }
    ]
  }
}
