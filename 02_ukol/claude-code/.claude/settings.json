{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "Bash",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "Skill",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.git/**)",
      "Write(./.git/**)",
      "Edit(./.git/**)",
      "Read(./node_modules/**)",
      "Read(./**/node_modules/**)",
      "Read(./.venv/**)",
      "Read(./**/.venv/**)"
    ]
  }
}

